<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Weight\WeightLogic.cs" Link="WeightLogic.cs" />
    <Compile Include="..\..\src\Stats\StatsLogic.cs" Link="StatsLogic.cs" />
    <Compile Include="..\..\src\Buffs\BuffsLogic.cs" Link="BuffsLogic.cs" />
    <Compile Include="..\..\src\Buffs\EffectLines.cs" Link="EffectLines.cs" />
    <Compile Include="..\..\src\Cures\CuresLogic.cs" Link="CuresLogic.cs" />
    <Compile Include="..\..\src\Web\PushSchedule.cs" Link="PushSchedule.cs" />
    <Compile Include="..\..\src\Web\PageJson.cs" Link="PageJson.cs" />
    <Compile Include="..\..\src\Shared\json\cs\*.cs" Link="Shared\json\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Shared\i18n\cs\*.cs" Link="Shared\i18n\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Shared\item-pool\cs\*.cs" Link="Shared\item-pool\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\src\i18n\*.json" LogicalName="StatsUI.i18n.%(Filename)%(Extension)" />
    <None Include="..\fixtures\*.json" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
